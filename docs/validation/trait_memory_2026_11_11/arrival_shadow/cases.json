[
  {
    "id": "01",
    "turns": [
      {
        "speaker": "登记员",
        "text": "晚班那两位怎么说？"
      },
      {
        "speaker": "同事",
        "text": "俞川和常鸣都回了“行，我肯定来”。"
      }
    ]
  },
  {
    "id": "02",
    "turns": [
      {
        "speaker": "俞川",
        "text": "我已经在签收台了。"
      },
      {
        "speaker": "登记员",
        "text": "常鸣呢？"
      },
      {
        "speaker": "俞川",
        "text": "他的定位我没看见。"
      }
    ]
  },
  {
    "id": "03",
    "turns": [
      {
        "speaker": "同事",
        "text": "我就在签收台，看着俞川和常鸣一人拆了一包封条。"
      }
    ]
  },
  {
    "id": "04",
    "turns": [
      {
        "speaker": "常鸣",
        "text": "我和俞川刚上车，离签收台还有两站。"
      }
    ]
  },
  {
    "id": "05",
    "turns": [
      {
        "speaker": "登记员",
        "text": "两个人都到了？"
      },
      {
        "speaker": "同事",
        "text": "到的是两箱纸，人我没看见。"
      }
    ]
  },
  {
    "id": "06",
    "turns": [
      {
        "speaker": "常鸣",
        "text": "我在台前。"
      },
      {
        "speaker": "俞川",
        "text": "你守一下，我从仓库往你那边走。"
      }
    ]
  },
  {
    "id": "07",
    "turns": [
      {
        "speaker": "俞川",
        "text": "我会来的。"
      },
      {
        "speaker": "常鸣",
        "text": "我也答应了。"
      },
      {
        "speaker": "登记员",
        "text": "好。"
      },
      {
        "speaker": "常鸣",
        "text": "更新一下，我们俩现在都在签收台。"
      }
    ]
  },
  {
    "id": "08",
    "turns": [
      {
        "speaker": "登记员",
        "text": "常鸣签到没？"
      },
      {
        "speaker": "同事",
        "text": "我只看见常鸣本人在台前，俞川的牌子倒是摆好了。"
      }
    ]
  },
  {
    "id": "09",
    "turns": [
      {
        "speaker": "同事",
        "text": "昨天是俞川和常鸣一起守台。"
      },
      {
        "speaker": "登记员",
        "text": "我问今天。"
      },
      {
        "speaker": "同事",
        "text": "今天我还没去看。"
      }
    ]
  },
  {
    "id": "10",
    "turns": [
      {
        "speaker": "俞川",
        "text": "我们都在签收台了。"
      },
      {
        "speaker": "常鸣",
        "text": "刚才是。现在我和俞川都被叫去库房了，交班前还得走回去。"
      }
    ]
  },
  {
    "id": "11",
    "turns": [
      {
        "speaker": "常鸣",
        "text": "我在路上，俞川说他一定来。"
      },
      {
        "speaker": "登记员",
        "text": "那就先记下这两句。"
      }
    ]
  },
  {
    "id": "12",
    "turns": [
      {
        "speaker": "登记员",
        "text": "签收台有人吗？"
      },
      {
        "speaker": "同事",
        "text": "俞川在我旁边数封套。常鸣刚也在台前坐下，跟我要了支笔。"
      }
    ]
  },
  {
    "id": "13",
    "turns": [
      {
        "speaker": "同事",
        "text": "有一位已经在台前了。"
      },
      {
        "speaker": "登记员",
        "text": "俞川还是常鸣？"
      },
      {
        "speaker": "同事",
        "text": "隔着展板，没看清。"
      }
    ]
  },
  {
    "id": "14",
    "turns": [
      {
        "speaker": "俞川",
        "text": "我俩都到展馆门口了，正往里头的签收台走。"
      }
    ]
  },
  {
    "id": "15",
    "turns": [
      {
        "speaker": "同事",
        "text": "俞川已经在台前。"
      },
      {
        "speaker": "登记员",
        "text": "常鸣也到了？"
      },
      {
        "speaker": "同事",
        "text": "我只说他答应来，没说他到了。"
      }
    ]
  },
  {
    "id": "16",
    "turns": [
      {
        "speaker": "登记员",
        "text": "他们要是都到了就开工。"
      },
      {
        "speaker": "常鸣",
        "text": "收到。"
      },
      {
        "speaker": "俞川",
        "text": "收到。"
      }
    ]
  }
]
