    {
      "original_id": "social_i1_feeling_policy_r0",
      "case_id": "social",
      "profile": "i1_feeling",
      "replicate": 0,
      "say": "雨一直下，安排又没定下来，确实容易让人烦。先别逼自己一下子全定好，可以分几步来：\n\n- 先只定一件最关键的：时间或地点，二选一先敲定。\n- 把“必须今天定”和“可以拖到明天”的分开，只处理前一类。\n- 如果人数还没齐，可以先发一句“时间地点我先定个大概，大家看行不行”，减少反复沟通。\n- 雨大不方便出门的话，也可以考虑改成室内或线上小聚，或者把准备事项分给别人一部分。\n\n你现在最卡的是哪一步——时间、地点，还是人没凑齐？",
      "decision": {
        "action": "advise",
        "allowed_actions": [
          "respond",
          "advise"
        ],
        "focus_id": "feeling",
        "focus_kind": "feeling",
        "commitment_id": null,
        "advice_permission": "unspecified",
        "state_revision": 0,
        "draw": 0.2649581493439749,
        "reason": "configured_intervention_draw"
